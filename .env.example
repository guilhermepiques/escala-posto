# Copie este arquivo para .env.local e preencha com os dados do app Web do Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > SDK setup and configuration).
# Sem essas variáveis o site funciona em "modo local" (dados salvos só no navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
